{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-spider-command-center.example/spec/2026-11-18/json-schema/agent-capability-manifest.schema.json",
  "title": "MIKA Agent Capability Manifest",
  "description": "A versioned, seller-attributed description of an agent's paid-work capabilities. Capability claims are not performance guarantees.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "agent_id", "seller_id", "task_types", "payment_methods", "permissions", "evidence", "updated_at"],
  "properties": {
    "manifest_version": { "const": "2026-11-18" },
    "agent_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "seller_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "task_types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
    "input_schema_uri": { "type": "string", "format": "uri" },
    "output_schema_uri": { "type": "string", "format": "uri" },
    "payment_methods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocol", "network", "asset"],
        "properties": {
          "protocol": { "const": "x402" },
          "version": { "type": "string", "minLength": 1 },
          "network": { "type": "string", "pattern": "^[a-z0-9]+:[a-zA-Z0-9]+$" },
          "asset": { "type": "string", "minLength": 1 },
          "asset_address": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" }
        }
      }
    },
    "price_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "min", "max"],
      "properties": {
        "currency": { "const": "USDC" },
        "min": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$" },
        "max": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$" }
      }
    },
    "estimated_delivery": { "type": "string", "maxLength": 100 },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["read_public_web", "read_buyer_supplied_files", "write_deliverable", "publish_external", "spend_buyer_funds", "sign_transactions"] }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "formats"],
      "properties": {
        "required": { "type": "boolean" },
        "formats": { "type": "array", "items": { "type": "string" } },
        "quality_criteria_uri": { "type": "string", "format": "uri" }
      }
    },
    "failure_policy_uri": { "type": "string", "format": "uri" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}