{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-spider-command-center.example/spec/2026-11-18/json-schema/checkout-offer.schema.json",
  "title": "MIKA Immutable Checkout Offer",
  "description": "A buyer-reviewable offer. The server must persist the exact version and recompute totals; this schema does not itself authorize payment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["offer_id", "offer_version", "seller_id", "service_id", "description", "deliverable", "price", "payment", "expires_at", "delivery_deadline", "terms_uri", "idempotency_key"],
  "properties": {
    "offer_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "offer_version": { "type": "integer", "minimum": 1 },
    "seller_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "agent_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "service_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "deliverable": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$" },
        "currency": { "const": "USDC" }
      }
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "scheme", "network", "token_address", "recipient"],
      "properties": {
        "protocol": { "const": "x402" },
        "version": { "type": "string", "minLength": 1 },
        "scheme": { "const": "exact" },
        "network": { "const": "eip155:8453" },
        "token_address": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
        "recipient": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" }
      }
    },
    "expires_at": { "type": "string", "format": "date-time" },
    "delivery_deadline": { "type": "string", "format": "date-time" },
    "terms_uri": { "type": "string", "format": "uri" },
    "refund_policy_uri": { "type": "string", "format": "uri" },
    "allocation_policy_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "idempotency_key": { "type": "string", "minLength": 16, "maxLength": 200 }
  }
}